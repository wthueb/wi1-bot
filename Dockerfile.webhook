FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -yqq --no-install-recommends git && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_PYTHON_DOWNLOADS=0 UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY common/pyproject.toml common/pyproject.toml
COPY arr/pyproject.toml arr/pyproject.toml
COPY bot/pyproject.toml bot/pyproject.toml
COPY webhook/pyproject.toml webhook/pyproject.toml
COPY transcoder/pyproject.toml transcoder/pyproject.toml

RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --package webhook \
    --no-dev --no-editable --no-install-workspace --compile-bytecode

COPY . .

RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --package webhook --no-dev --no-editable

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -yqq --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="wi1-bot-webhook" \
    org.opencontainers.image.description="Radarr/Sonarr download webhook and transcode job server for wi1-bot" \
    org.opencontainers.image.source="https://github.com/wthueb/wi1-bot" \
    org.opencontainers.image.licenses="MIT" \
    org.opencontainers.image.authors="William Huebner <wilhueb@gmail.com>"

ENV WB_CONFIG_PATH=/config/config.yaml
ENV WB_LOG_DIR=/logs
ENV WB_DB_PATH=/data/wi1_bot.db

RUN mkdir -p /config /logs /data

COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:9000/health"]

ENTRYPOINT ["wi1-bot-webhook"]
